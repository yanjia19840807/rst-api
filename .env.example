# Local only. Copy to .env (gitignored). Keys must match application.yml.
# Profile defaults to uat.

# Database
DB_URL=jdbc:postgresql://localhost:5432/rst
DB_USERNAME=postgres
DB_PASSWORD=

# Microsoft Graph credentials
MS_GRAPH_CLIENT_ID=2b5ec0be-1344-4161-80f5-b7674d74f019
MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TENANT_ID=          # defaults to the Entra tenant in application.yml
# MS_GRAPH_SECRET_NAME=timesheet-prd-microsoft-graph-credentials

# Timesheet SharePoint library
# TIMESHEET_SHAREPOINT_SITE=https://cmacgmgroup.sharepoint.com/sites/CMA-SharedKPIAutomation
# TIMESHEET_SHAREPOINT_LIBRARY=Timesheet
# 4.RST/2.UAT on profile uat. Leave unset so the profile default applies.
# TIMESHEET_SHAREPOINT_ROOT=
# TIMESHEET_SYNC_DAILY_ENABLED=false
# TIMESHEET_SYNC_MONTHLY_ENABLED=false

# GBS Process catalog — SharePoint list via Graph (uat default true in application-uat.yml)
PROCESS_REMOTE=true
# PROCESS_CLASSPATH=timesheet/GBS Process.csv
# PROCESS_SHAREPOINT_SITE=https://cmacgmgroup.sharepoint.com/sites/CMA-GlobalBusinessServices
# PROCESS_SHAREPOINT_LIST=GBS Process

# Forecast
FORECAST_BASE_URL=http://localhost:8000
FORECAST_ENABLED=true
# Same variable name on rst-forecast. Blank skips X-API-Key locally.
FORECAST_API_KEY=

# Mail
MAIL_ENABLED=true
MAIL_REDIRECT_TO=
# MAIL_FROM=GBS.TIMESHEET@cma-cgm.com

# Optional overrides
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SESSION_COOKIE_SECURE=false

# Azure app for profile uat. Do not set SPRING_PROFILES_ACTIVE here.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
